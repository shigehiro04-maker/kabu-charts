const F=D.f, IX=Object.fromEntries(F.map((k,i)=>[k,i])), R=D.r;
const $=s=>document.querySelector(s);
const cs=getComputedStyle(document.documentElement), C=v=>cs.getPropertyValue(v).trim();
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function fmt(v,nd=0){if(v==null||v==='')return '–';if(typeof v!=='number')return esc(v);
  return v.toLocaleString('ja-JP',{minimumFractionDigits:nd,maximumFractionDigits:nd});}
function sh(v){if(v==null)return '–';const a=Math.abs(v);return a>=1e8?(v/1e8).toFixed(2)+'億':a>=1e4?(v/1e4).toFixed(a>=1e6?0:1)+'万':fmt(v);}
function sg(v,nd=1,suf=''){if(v==null)return '–';const c=v>0?'up':v<0?'dn':'';return `<span class="${c}">${v>0?'+':''}${fmt(v,nd)}${suf}</span>`;}
const badge=v=>`<span class="badge v-${esc(v)}">${esc(v)}</span>`;
const g=(r,k)=>r[IX[k]];

/* ---------- 上のタイル ---------- */
(function(){const S=D.sum,t=[];
 const tile=(k,v,s)=>t.push(`<div class="tile"><div class="k">${k}</div><div class="v">${v}</div><div class="s">${s||''}</div></div>`);
 tile('市場の信用倍率',S.信用倍率!=null?S.信用倍率.toFixed(2)+'倍':'–','普通株・時価ベース '+S.asof);
 tile('信用買い評価損益率',S.評価損益率!=null?sg(S.評価損益率,1,'%'):'–','−20%前後で投げが出やすい');
 tile('空売り比率',S.空売り比率!=null?S.空売り比率.toFixed(1)+'%':'–',S.空売り比率25日!=null?`25日平均 ${S.空売り比率25日.toFixed(1)}%（${S.空売り日付||''}）`:'');
 tile('海外投資家（プライム）',S.海外!=null?sg(S.海外,0,'億円'):'–',S.週?`${S.週} までの週`:'');
 tile('個人（プライム）',S.個人!=null?sg(S.個人,0,'億円'):'–',S.週?`${S.週} までの週`:'');
 tile('踏み上げ候補',(S.判定['踏み上げ候補']||0)+'銘柄',(S.踏み上げ候補||[]).slice(0,3).map(x=>esc(x[1])).join('・'));
 $('#tiles').innerHTML=t.join('');})();

/* ---------- タブ ---------- */
function show(s){document.querySelectorAll('.sec').forEach(e=>e.classList.toggle('on',e.id==='s-'+s));
 document.querySelectorAll('#tabs a').forEach(a=>a.classList.toggle('on',a.dataset.s===s));
 if(s==='market')drawMarket(); if(s==='rank')drawRank(); if(s==='sector')drawSector();}
document.querySelectorAll('#tabs a').forEach(a=>a.onclick=e=>{e.preventDefault();show(a.dataset.s);history.replaceState(null,'','#'+a.dataset.s);});

/* ---------- 銘柄を調べる ---------- */
const BYCODE=Object.fromEntries(R.map(r=>[r[IX['コード']],r]));
const charts={};
function mk(id,cfg){if(charts[id])charts[id].destroy();const el=document.getElementById(id);if(!el||!window.Chart)return;charts[id]=new Chart(el,cfg);}
const axis={ticks:{color:C('--muted'),maxTicksLimit:6},grid:{color:C('--grid')}};
const xaxis={ticks:{color:C('--muted'),maxTicksLimit:6,maxRotation:0},grid:{display:false}};
const legend={position:'bottom',labels:{boxWidth:10,color:C('--ink2')}};
$('#q').addEventListener('input',e=>{const q=e.target.value.trim();if(!q){$('#sugg').innerHTML='';return;}
 const Q=q.toUpperCase();
 const hit=R.filter(r=>String(r[IX['コード']]).startsWith(Q)||String(r[IX['銘柄名']]).includes(q)).slice(0,12);
 $('#sugg').innerHTML=hit.map(r=>`<button data-c="${r[IX['コード']]}">${r[IX['コード']]} ${esc(r[IX['銘柄名']])}</button>`).join('');
 if(BYCODE[Q])open_(Q);});
$('#q').addEventListener('keydown',e=>{if(e.key==='Enter'){const b=$('#sugg button');if(b)open_(b.dataset.c);}});
$('#sugg').addEventListener('click',e=>{const b=e.target.closest('button');if(b)open_(b.dataset.c);});
window.JK_LOAD=function(o){drawStock(o);};
function open_(c){const r=BYCODE[c];if(!r)return;show('stock');history.replaceState(null,'','#'+c);
 const v=k=>r[IX[k]];
 const t=(k,val,s)=>`<div class="tile"><div class="k">${k}</div><div class="v">${val}</div><div class="s">${s||''}</div></div>`;
 $('#detail').innerHTML=`<div class="panel"><h2>${esc(c)} ${esc(v('銘柄名'))} <span class="meta">${esc(v('市場'))}・${esc(v('業種'))}・${esc(v('信用区分')||'')}</span></h2>
 <div>${badge(v('需給判定'))} 需給スコア <b>${fmt(v('需給スコア'))}</b>${v('規制等')?` ・印 <b>${esc(v('規制等'))}</b>`:''} ・終値 ${fmt(v('終値'),1)}円 ・20日 ${sg(v('20日騰落率(%)'),1,'%')}</div>
 <p class="memo">${esc(v('需給メモ')||'')}</p></div>
 <div class="tiles">
 ${t('信用買残',sh(v('信用買残(株)'))+'株',`前日比 ${sg(v('買残前日比(株)'),0)}・5日 ${sg(v('買残5日変化(%)'),1,'%')}`)}
 ${t('信用売残',sh(v('信用売残(株)'))+'株',`前日比 ${sg(v('売残前日比(株)'),0)}`)}
 ${t('信用倍率',v('信用倍率(倍)')!=null?fmt(v('信用倍率(倍)'),2)+'倍':'売残なし',`上場比 買${fmt(v('買残上場比(%)'),2)}%・売${fmt(v('売残上場比(%)'),2)}%`)}
 ${t('買残回転日数',v('買残回転日数(日)')!=null?fmt(v('買残回転日数(日)'),1)+'日':'–',`売残 ${fmt(v('売残回転日数(日)'),2)}日（25日平均出来高比）`)}
 ${t('買い方の評価損益率',sg(v('信用買い評価損益率(%)'),1,'%'),`売り方 ${sg(v('信用売り評価損益率(%)'),1,'%')}`)}
 ${t('日証金 貸借倍率',v('貸借倍率(倍)')!=null?fmt(v('貸借倍率(倍)'),2)+'倍':'–',`逆日歩 ${v('逆日歩(円)')?fmt(v('逆日歩(円)'),2)+'円':'なし'}`)}
 ${t('大口空売り',v('大口空売り比率(%)')!=null?fmt(v('大口空売り比率(%)'),2)+'%':'報告なし',v('大口空売り報告数')?`${v('大口空売り報告数')}件・30日 ${sg(v('大口空売り30日変化(%pt)'),2,'pt')}`:'0.5%以上の報告')}
 ${t('出来高倍率',v('出来高倍率(当日/25日)')!=null?fmt(v('出来高倍率(当日/25日)'),2)+'倍':'–',`売買代金25日平均 ${fmt(v('売買代金25日平均(百万円)'))}百万円`)}
 </div>
 <div class="panel"><div class="two"><div><h3>信用残と株価（日次）</h3><div class="chartbox"><canvas id="cm" role="img" aria-label="信用買残・売残と株価"></canvas></div><p class="tip" id="mtip"></p></div>
 <div><h3>株価と出来高（120日）</h3><div class="chartbox"><canvas id="cp" role="img" aria-label="株価と出来高"></canvas></div></div></div>
 <div class="two"><div><h3>価格帯別出来高（60日）</h3><div id="vp" class="vp"></div><p class="tip">最多価格帯 ${fmt(v('価格帯別出来高最多価格(円)'),0)}円（現在値は${sg(v('最多価格帯からの乖離(%)'),1,'%')}）・上値の出来高 ${fmt(v('上値出来高比率(%)'))}%。オレンジが現在値の帯。</p></div>
 <div><h3>大口の空売り（残高割合0.5%以上の報告・最新）</h3><div id="sptbl" class="scroll"><p class="meta">報告なし</p></div></div></div></div>`;
 const s=document.createElement('script');s.src='jukyu/'+c+'.js';s.onerror=()=>{$('#mtip').textContent='銘柄データを読めませんでした';};document.body.appendChild(s);}
function drawStock(o){
 if(o.m){const n=o.m.d.length;
  mk('cm',{data:{labels:o.m.d,datasets:[
   {type:'bar',label:'買残',data:o.m.b,backgroundColor:C('--s1'),yAxisID:'y',order:2},
   {type:'bar',label:'売残',data:o.m.s,backgroundColor:C('--s2'),yAxisID:'y',order:2},
   {type:'line',label:'株価',data:o.m.p||[],borderColor:C('--ink2'),backgroundColor:C('--ink2'),pointRadius:n<30?3:0,borderWidth:2,yAxisID:'y1',order:1}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},
   scales:{x:xaxis,y:{...axis,ticks:{...axis.ticks,callback:x=>sh(x)}},y1:{...axis,position:'right',grid:{display:false}}}}});
  $('#mtip').textContent=n<20?`銘柄別の日次信用残は取得開始から ${n} 日分。毎営業日たまっていきます。`:'';}
 if(o.pr){mk('cp',{data:{labels:o.pr.d,datasets:[
   {type:'line',label:'終値',data:o.pr.c,borderColor:C('--s1'),backgroundColor:C('--s1'),pointRadius:0,borderWidth:2,yAxisID:'y',order:1},
   {type:'bar',label:'出来高',data:o.pr.v,backgroundColor:C('--grid'),yAxisID:'y1',order:2}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},
   scales:{x:xaxis,y:axis,y1:{...axis,position:'right',grid:{display:false},ticks:{...axis.ticks,callback:x=>sh(x)}}}}});}
 if(o.vp){const h=o.vp.h,lo=o.vp.lo,hi=o.vp.hi,st=(hi-lo)/h.length,mx=Math.max(...h)||1;
  const cur=BYCODE[o.code][IX['終値']];let out='';
  for(let i=h.length-1;i>=0;i--){const a=lo+st*i,b=a+st,on=cur>=a&&(cur<b||i===h.length-1);
   out+=`<div class="p">${fmt((a+b)/2,a>=1000?0:1)}</div><div><div class="b${on?' cur':''}" style="width:${(h[i]/mx*100).toFixed(1)}%"></div></div>`;}
  $('#vp').innerHTML=out;}
 if(o.sp&&o.sp.length){$('#sptbl').innerHTML='<table class="tbl"><tr><th>報告者</th><th class="n">割合</th><th class="n">前回</th><th>計算日</th></tr>'+
  o.sp.map(x=>`<tr><td>${esc(x[0])}</td><td class="n">${fmt(x[1],2)}%</td><td class="n">${x[3]!=null?fmt(x[3],2)+'%':'–'}</td><td>${esc(x[2])}</td></tr>`).join('')+'</table>';}
}

/* ---------- ランキング ---------- */
const LISTS=[
 ['踏み上げ候補','売り長で、逆日歩や大口空売りがあり、株価が25日線の上。売り方の買い戻しで上がりやすい形',r=>g(r,'需給判定')==='踏み上げ候補','需給スコア',-1],
 ['好需給','需給スコア65以上',r=>g(r,'需給判定')==='好需給','需給スコア',-1],
 ['売り長（貸借銘柄）','信用倍率1倍未満の貸借銘柄（売買代金25日平均1億円以上）',r=>g(r,'信用区分')==='貸借'&&g(r,'信用倍率(倍)')!=null&&g(r,'信用倍率(倍)')<1&&g(r,'売買代金25日平均(百万円)')>=100,'信用倍率(倍)',1],
 ['買残重い','信用倍率8倍以上かつ買残が出来高7日分以上',r=>g(r,'需給判定')==='買残重い','買残回転日数(日)',-1],
 ['投げ警戒','買い方の評価損益率−20%以下で買残が出来高5日分以上',r=>g(r,'需給判定')==='投げ警戒','信用買い評価損益率(%)',1],
 ['買残急増','買残が5営業日で増えた順（買残が出来高1日分以上）',r=>g(r,'買残5日変化(%)')!=null&&g(r,'買残回転日数(日)')>=1,'買残5日変化(%)',-1],
 ['買残の前日増','前日比の買残増加（株数×株価）の大きい順',r=>g(r,'買残前日比(株)')>0,'_bdv',-1],
 ['売残の前日増','前日比の売残増加（株数×株価）の大きい順',r=>g(r,'売残前日比(株)')>0,'_sdv',-1],
 ['逆日歩','日証金で逆日歩が付いた銘柄（年率換算の大きい順）',r=>g(r,'逆日歩(円)')>0,'逆日歩(年率%)',-1],
 ['大口空売り','残高割合0.5%以上の空売り報告の合計が大きい順',r=>g(r,'大口空売り比率(%)')!=null,'大口空売り比率(%)',-1],
 ['出来高急増','当日の出来高が25日平均の3倍以上（売買代金25日平均0.5億円以上）',r=>g(r,'出来高倍率(当日/25日)')>=3&&g(r,'売買代金25日平均(百万円)')>=50,'出来高倍率(当日/25日)',-1],
 ['規制・注意','JPXの信用規制・日々公表、日証金の貸株注意喚起など（印：規=規制 日=日々公表 監=監理 株=貸株申込制限 喚=貸株注意喚起 ○=注意喚起）',r=>g(r,'規制等'),'需給スコア',-1],
];
const RCOLS=[['コード','コード',0,'s'],['銘柄名','銘柄',0,'s'],['需給判定','判定',0,'b'],['需給スコア','点',0],['終値','株価',0],
 ['信用倍率(倍)','倍率',2],['信用買残(株)','買残',0,'sh'],['買残5日変化(%)','買残5日%',1,'sg'],['買残回転日数(日)','買残日数',1],
 ['信用買い評価損益率(%)','買い評価%',1,'sg'],['貸借倍率(倍)','貸借倍率',2],['逆日歩(円)','逆日歩',2],
 ['大口空売り比率(%)','大口空売%',2],['出来高倍率(当日/25日)','出来高倍',2],['20日騰落率(%)','20日%',1,'sg']];
let cur=0,sortk=null,sortd=-1;
$('#chips').innerHTML=LISTS.map((l,i)=>`<button data-i="${i}">${l[0]} <span class="meta">${R.filter(l[2]).length}</span></button>`).join('');
$('#chips').onclick=e=>{const b=e.target.closest('button');if(!b)return;cur=+b.dataset.i;sortk=null;drawRank();};
function val(r,k){if(k==='_bdv')return (g(r,'買残前日比(株)')||0)*(g(r,'終値')||0);if(k==='_sdv')return (g(r,'売残前日比(株)')||0)*(g(r,'終値')||0);return g(r,k);}
function drawRank(){const L=LISTS[cur];document.querySelectorAll('#chips button').forEach((b,i)=>b.classList.toggle('on',i===cur));
 $('#rankdesc').textContent=L[1];
 const k=sortk||L[3],dir=sortk?sortd:L[4];
 const rows=R.filter(L[2]).sort((a,b)=>{const x=val(a,k),y=val(b,k);if(x==null)return 1;if(y==null)return -1;return (x>y?1:x<y?-1:0)*dir;}).slice(0,200);
 const cell=(r,c)=>{const x=g(r,c[0]);if(c[3]==='s')return `<td>${esc(x)}</td>`;if(c[3]==='b')return `<td>${badge(x)}</td>`;
  if(c[3]==='sh')return `<td class="n">${sh(x)}</td>`;if(c[3]==='sg')return `<td class="n">${sg(x,c[2])}</td>`;return `<td class="n">${fmt(x,c[2])}</td>`;};
 $('#rank').innerHTML='<tr>'+RCOLS.map(c=>`<th data-k="${c[0]}" class="${c[3]==='s'||c[3]==='b'?'':'n'}">${c[1]}</th>`).join('')+'</tr>'+
  (rows.length?rows.map(r=>`<tr class="rw" data-c="${g(r,'コード')}">`+RCOLS.map(c=>cell(r,c)).join('')+'</tr>').join(''):'<tr><td colspan="15" class="meta">該当なし</td></tr>');}
$('#rank').addEventListener('click',e=>{const th=e.target.closest('th');if(th){const k=th.dataset.k;sortd=(sortk===k)?-sortd:-1;sortk=k;drawRank();return;}
 const tr=e.target.closest('tr.rw');if(tr)open_(tr.dataset.c);});

/* ---------- 市場全体 ---------- */
let mdrawn=false;const INVK=['海外投資家','個人','信託銀行','事業法人','投資信託','自己'];const invOn=new Set(['海外投資家','個人','信託銀行','事業法人']);
function drawMarket(){const M=D.mkt;
 if(!mdrawn&&M.w){mk('cw',{type:'line',data:{labels:M.w.d,datasets:[
   {label:'買残',data:M.w.b,borderColor:C('--s1'),backgroundColor:C('--s1'),pointRadius:0,borderWidth:2},
   {label:'売残',data:M.w.s,borderColor:C('--s2'),backgroundColor:C('--s2'),pointRadius:0,borderWidth:2}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},scales:{x:xaxis,y:axis}}});
  mk('cwr',{type:'line',data:{labels:M.w.d,datasets:[{label:'信用倍率',data:M.w.r,borderColor:C('--s3'),backgroundColor:C('--s3'),pointRadius:0,borderWidth:2}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false}},scales:{x:xaxis,y:axis}}});}
 if(!mdrawn&&M.d){const pr=M.d.d.length<30?3:0;mk('cpl',{type:'line',data:{labels:M.d.d,datasets:[
   {label:'買い方',data:M.d.pl,borderColor:C('--s1'),backgroundColor:C('--s1'),pointRadius:pr,borderWidth:2},
   {label:'売り方',data:M.d.spl,borderColor:C('--s2'),backgroundColor:C('--s2'),pointRadius:pr,borderWidth:2}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},scales:{x:xaxis,y:{...axis,ticks:{...axis.ticks,callback:x=>x+'%'}}}}});}
 if(!mdrawn&&M.ss){mk('css',{type:'line',data:{labels:M.ss.d,datasets:[
   {label:'空売り比率',data:M.ss.r,borderColor:C('--s2'),backgroundColor:C('--s2'),pointRadius:0,borderWidth:1.5},
   {label:'25日平均',data:M.ss.ma,borderColor:C('--ink2'),backgroundColor:C('--ink2'),borderDash:[5,4],pointRadius:0,borderWidth:1.5},
   {label:'40%',data:M.ss.d.map(()=>40),borderColor:C('--critical'),backgroundColor:C('--critical'),borderWidth:1,pointRadius:0,borderDash:[2,3]}]},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},scales:{x:xaxis,y:{...axis,ticks:{...axis.ticks,callback:x=>x+'%'}}}}});}
 if(M.inv){if(!mdrawn)$('#invchips').innerHTML=INVK.filter(k=>M.inv[k]).map(k=>`<button data-k="${k}" class="${invOn.has(k)?'on':''}">${k}</button>`).join('');
  const pal=[C('--s1'),C('--s2'),C('--s3'),C('--s4'),C('--s5'),C('--muted')];
  const ks=INVK.filter(k=>M.inv[k]&&invOn.has(k));
  const n=52,lab=M.inv.d.slice(-n);
  mk('ci',{type:'bar',data:{labels:lab,datasets:ks.map(k=>({label:k,data:M.inv[k].slice(-n),backgroundColor:pal[INVK.indexOf(k)]}))},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},scales:{x:xaxis,y:axis}}});
  const cum=a=>{let s=0;return a.map(x=>s+=(x||0));};
  mk('cic',{type:'line',data:{labels:M.inv.d,datasets:ks.map(k=>({label:k,data:cum(M.inv[k]),borderColor:pal[INVK.indexOf(k)],backgroundColor:pal[INVK.indexOf(k)],pointRadius:0,borderWidth:2}))},
   options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend},scales:{x:xaxis,y:axis}}});
  if(!mdrawn){const L=M.inv.d.length-1,keys=Object.keys(M.inv).filter(k=>k!=='d');
   const sm=(k,n)=>M.inv[k].slice(-n).reduce((a,b)=>a+(b||0),0);
   $('#invtbl').innerHTML='<table class="tbl"><tr><th>部門</th><th class="n">'+esc(M.inv.d[L])+'までの週</th><th class="n">4週累計</th><th class="n">13週累計</th><th class="n">52週累計</th></tr>'+
    keys.map(k=>`<tr><td>${esc(k)}</td><td class="n">${sg(M.inv[k][L],0)}</td><td class="n">${sg(sm(k,4),0)}</td><td class="n">${sg(sm(k,13),0)}</td><td class="n">${sg(sm(k,52),0)}</td></tr>`).join('')+'</table>';}}
 mdrawn=true;}
$('#invchips').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const k=b.dataset.k;invOn.has(k)?invOn.delete(k):invOn.add(k);b.classList.toggle('on');drawMarket();});

/* ---------- 業種別 ---------- */
let sk='信用倍率(倍)',sd=1;
function drawSector(){const c=D.sec.c,rows=D.sec.r.slice();const i=c.indexOf(sk)+1;
 rows.sort((a,b)=>{const x=a[i],y=b[i];if(x==null)return 1;if(y==null)return -1;return (x-y)*sd;});
 $('#sect').innerHTML='<tr><th>業種</th>'+c.map(k=>`<th class="n" data-k="${esc(k)}">${esc(k)}</th>`).join('')+'</tr>'+
  rows.map(r=>'<tr><td>'+r[0]+'</td>'+r.slice(1).map((x,j)=>`<td class="n">${/前日比|評価損益/.test(c[j])?sg(x,1):fmt(x,/銘柄数|億円/.test(c[j])?0:/比率|中央値/.test(c[j])?1:2)}</td>`).join('')+'</tr>').join('');}
$('#sect').addEventListener('click',e=>{const th=e.target.closest('th');if(!th||!th.dataset.k)return;sd=(sk===th.dataset.k)?-sd:1;sk=th.dataset.k;drawSector();});

/* ---------- 起動 ---------- */
(function(){const h=decodeURIComponent(location.hash.slice(1));if(BYCODE[h])open_(h);else if(['rank','market','sector','guide'].includes(h))show(h);
 else{const top=R.find(r=>r[IX['需給判定']]==='踏み上げ候補')||R[0];if(top)open_(top[IX['コード']]);}})();
</script></body></html>
